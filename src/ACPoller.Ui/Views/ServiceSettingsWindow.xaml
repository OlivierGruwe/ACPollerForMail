<mah:MetroWindow x:Class="ACPoller.Ui.Views.ServiceSettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 Title="Reglages du service"
                 Height="760"
                 Width="820"
                 WindowStartupLocation="CenterOwner"
                 TitleCharacterCasing="Normal">

  <Window.Resources>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,10,0,3" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Opacity" Value="0.75" />
    </Style>

    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,20,0,8" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Avertissement AVANT la saisie et non apres l'enregistrement :
         prevenir apres coup laisse l'exploitant croire que sa modification
         est deja active. -->
    <Border Grid.Row="0" Background="#33C9942B" BorderBrush="#C9942B" BorderThickness="1"
            CornerRadius="3" Padding="12,10" Margin="0,0,0,14">
      <TextBlock TextWrapping="Wrap" FontSize="11"
                 Text="Ces reglages ne sont pas rechargeables a chaud. Toute modification enregistree ici ne prendra effet qu'apres un redemarrage complet du service, et la capture est interrompue pendant ce temps." />
    </Border>

    <TabControl Grid.Row="1">

      <TabItem Header="Service">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16">

            <TextBlock Text="Repertoire de travail" Style="{StaticResource Label}" />
            <TextBox Text="{Binding WorkDirectory, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="Consolas" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="Contient les unites de travail en cours, le journal des messages traites et la quarantaine. Le changer PERD le journal d'idempotence : les messages encore presents dans les boites seront retraites, donc des doublons en GED." />

            <TextBlock Text="Traitements simultanes, toutes boites confondues" Style="{StaticResource Label}" />
            <mah:NumericUpDown Value="{Binding MaxGlobalConcurrency}" Minimum="1" Maximum="64"
                               Width="120" HorizontalAlignment="Left" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="Borne le travail reel, pas le nombre de workers. Cent boites peuvent ecouter avec quatre traitements a la fois. Augmenter au-dela du nombre de profils LibreOffice ne sert a rien : la conversion deviendra le goulot." />

            <TextBlock Text="Repertoire des plugins" Style="{StaticResource Label}" />
            <TextBox Text="{Binding PluginDirectory, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="Consolas" />

            <TextBlock Text="Retention du journal des messages traites (jours)" Style="{StaticResource Label}" />
            <mah:NumericUpDown Value="{Binding ProcessedRetentionDays}" Minimum="1" Maximum="3650"
                               Width="120" HorizontalAlignment="Left" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="Au-dela, une entree est purgee. Trop court, un message ancien laisse dans une boite serait retraite. La valeur doit depasser la duree pendant laquelle un message peut rester non traite." />

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Outils">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16">

            <TextBlock Text="LibreOffice (soffice.exe)" Style="{StaticResource Label}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0" FontFamily="Consolas"
                       Text="{Binding SofficePath, UpdateSourceTrigger=PropertyChanged}" />
              <Button Grid.Column="2" Content="Parcourir" Padding="12,3"
                      Command="{Binding BrowseCommand}" CommandParameter="soffice" />
            </Grid>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Sans LibreOffice, aucune piece bureautique n'est convertie : Word, Excel et PowerPoint sortent en page de substitution. Apache OpenOffice ne convient pas, son soffice ne gere pas la conversion en ligne de commande." />

            <TextBlock Text="Profils LibreOffice simultanes" Style="{StaticResource Label}" />
            <mah:NumericUpDown Value="{Binding LibreOfficeProfiles}" Minimum="1" Maximum="16"
                               Width="120" HorizontalAlignment="Left" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="Chaque conversion utilise un profil isole. Deux conversions partageant un profil se bloquent mutuellement, c'est pourquoi ce nombre borne reellement la conversion parallele." />

            <TextBlock Text="qpdf" Style="{StaticResource Label}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0" FontFamily="Consolas"
                       Text="{Binding QpdfPath, UpdateSourceTrigger=PropertyChanged}" />
              <Button Grid.Column="2" Content="Parcourir" Padding="12,3"
                      Command="{Binding BrowseCommand}" CommandParameter="qpdf" />
            </Grid>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Repare les PDF que le moteur de lecture refuse. Sur un flux de factures reelles, cela represente quelques pourcents des documents, qui seraient sinon livres sans etre fusionnes." />

            <TextBlock Text="Repertoire des polices" Style="{StaticResource Label}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0" FontFamily="Consolas"
                       Text="{Binding FontDirectory, UpdateSourceTrigger=PropertyChanged}" />
              <Button Grid.Column="2" Content="Parcourir" Padding="12,3"
                      Command="{Binding BrowseCommand}" CommandParameter="fonts" />
            </Grid>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Les polices sont incorporees dans les PDF produits, qui sont archives des annees. Dependre d'une police systeme fait varier le rendu d'un serveur a l'autre." />

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Maintenance">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16">

            <TextBlock Text="Periode entre deux passes (minutes)" Style="{StaticResource Label}" />
            <mah:NumericUpDown Value="{Binding MaintenanceIntervalMinutes}" Minimum="5" Maximum="1440"
                               Width="120" HorizontalAlignment="Left" />

            <TextBlock Text="Mise en quarantaine apres (jours)" Style="{StaticResource Label}" />
            <mah:NumericUpDown Value="{Binding QuarantineAfterDays}" Minimum="1" Maximum="365"
                               Width="120" HorizontalAlignment="Left" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="Une unite de travail inachevee depuis plus longtemps est deplacee en quarantaine plutot que supprimee : elle porte le MIME d'origine, seul moyen de rejouer le message apres correction." />

            <TextBlock Text="Seuil d'alerte d'espace disque (%)" Style="{StaticResource Label}" />
            <mah:NumericUpDown Value="{Binding LowDiskThresholdPercent}" Minimum="1" Maximum="90"
                               Width="120" HorizontalAlignment="Left" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="En dessous, une alerte est journalisee et affichee. La capture ne s'arrete pas d'elle-meme : elle echouera a saturation, ce qui est bien plus brutal." />

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Pilotage">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16">

            <CheckBox Content="Activer l'API de pilotage" IsChecked="{Binding ControlApiEnabled}" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="La desactiver rend cette interface inutilisable : elle ne communique avec le service que par cette API. Il faudra reactiver le reglage a la main dans le fichier de configuration." />

            <TextBlock Text="Port d'ecoute" Style="{StaticResource Label}" />
            <mah:NumericUpDown Value="{Binding ControlApiPort}" Minimum="1024" Maximum="65535"
                               Width="120" HorizontalAlignment="Left" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="Ecoute uniquement sur la boucle locale. Apres changement, penser a corriger l'adresse dans les reglages de connexion de cette interface." />

            <TextBlock Text="Jeton de pilotage (vide = inchange)" Style="{StaticResource Label}" />
            <TextBox Text="{Binding ControlApiToken, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="Consolas" />
            <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#C9942B" Margin="0,4,0,0"
                       Text="Changer le jeton invalide TOUS les postes d'exploitation deja configures, y compris celui-ci. Il faudra le reporter dans les reglages de connexion de chaque interface." />

            <TextBlock Text="Base de metriques (vide = inchange)" Style="{StaticResource Label}" />
            <TextBox Text="{Binding MetricsConnectionString, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="Consolas" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="Chaine de connexion SQL Server pour l'historique long. Le tableau de bord fonctionne sans elle, sur une fenetre de vingt-quatre heures en memoire." />

          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="4,12,0,0">
      <TextBlock.Style>
        <Style TargetType="TextBlock">
          <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Text}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
              <Setter Property="Foreground" Value="#E04A4A" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>

    <ItemsControl Grid.Row="3" ItemsSource="{Binding Issues}" Margin="4,6,0,0">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <TextBlock TextWrapping="Wrap" Margin="0,2" Foreground="#E04A4A">
            <Run Text="{Binding Path, Mode=OneWay}" FontFamily="Consolas" FontSize="11" />
            <Run Text=" " />
            <Run Text="{Binding Message, Mode=OneWay}" />
          </TextBlock>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <mah:ProgressRing Width="18" Height="18" Margin="0,0,12,0" IsActive="{Binding IsBusy}" />
      <Button Content="Fermer" IsCancel="True"
              Style="{StaticResource MahApps.Styles.Button.Square}" Padding="20,6" />
      <Button Content="Enregistrer" Click="OnSave"
              IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
              Style="{StaticResource MahApps.Styles.Button.Square.Accent}"
              Padding="20,6" Margin="8,0,0,0" />
    </StackPanel>
  </Grid>
</mah:MetroWindow>
