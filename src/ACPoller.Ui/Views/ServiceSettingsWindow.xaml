<mah:MetroWindow x:Class="ACPoller.Ui.Views.ServiceSettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 Title="Reglages du service"
                 Height="760"
                 Width="820"
                 WindowStartupLocation="CenterOwner"
                 TitleCharacterCasing="Normal">

  <Window.Resources>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,10,0,3" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Opacity" Value="0.75" />
    </Style>

    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,20,0,8" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Avertissement AVANT la saisie et non apres l'enregistrement :
         prevenir apres coup laisse l'exploitant croire que sa modification
         est deja active. -->
    <Border Grid.Row="0" Background="#33C9942B" BorderBrush="#C9942B" BorderThickness="1"
            CornerRadius="3" Padding="12,10" Margin="0,0,0,14">
      <TextBlock TextWrapping="Wrap" FontSize="11"
                 Text="{DynamicResource S_Svc_CesReglagesNeSont}" />
    </Border>

    <TabControl Grid.Row="1">

      <TabItem Header="{DynamicResource S_Svc_Service}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16">

            <TextBlock Text="{DynamicResource S_Svc_RepertoireDeTravail}" Style="{StaticResource Label}" />
            <TextBox Text="{Binding WorkDirectory, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="Consolas" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="{DynamicResource S_Svc_ContientLesUnitesDe}" />

            <TextBlock Text="{DynamicResource S_Svc_TraitementsSimultanesToutesBoites}" Style="{StaticResource Label}" />
            <mah:NumericUpDown Value="{Binding MaxGlobalConcurrency}" Minimum="1" Maximum="64"
                               Width="120" HorizontalAlignment="Left" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="{DynamicResource S_Svc_BorneLeTravailReel}" />

            <TextBlock Text="{DynamicResource S_Svc_RepertoireDesPlugins}" Style="{StaticResource Label}" />
            <TextBox Text="{Binding PluginDirectory, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="Consolas" />

            <TextBlock Text="{DynamicResource S_Svc_RetentionDuJournalDes}" Style="{StaticResource Label}" />
            <mah:NumericUpDown Value="{Binding ProcessedRetentionDays}" Minimum="1" Maximum="3650"
                               Width="120" HorizontalAlignment="Left" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="{DynamicResource S_Svc_AuDelaUneEntree}" />

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{DynamicResource S_Svc_Outils}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16">

            <TextBlock Text="{DynamicResource S_Svc_LibreofficeSofficeExe}" Style="{StaticResource Label}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0" FontFamily="Consolas"
                       Text="{Binding SofficePath, UpdateSourceTrigger=PropertyChanged}" />
              <Button Grid.Column="2" Content="{DynamicResource S_Svc_Parcourir}" Padding="12,3"
                      Command="{Binding BrowseCommand}" CommandParameter="soffice" />
            </Grid>
            <TextBlock Style="{StaticResource Hint}"
                       Text="{DynamicResource S_Svc_SansLibreofficeAucunePiece}" />

            <TextBlock Text="{DynamicResource S_Svc_ProfilsLibreofficeSimultanes}" Style="{StaticResource Label}" />
            <mah:NumericUpDown Value="{Binding LibreOfficeProfiles}" Minimum="1" Maximum="16"
                               Width="120" HorizontalAlignment="Left" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="{DynamicResource S_Svc_ChaqueConversionUtiliseUn}" />

            <TextBlock Text="{DynamicResource S_Svc_Qpdf}" Style="{StaticResource Label}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0" FontFamily="Consolas"
                       Text="{Binding QpdfPath, UpdateSourceTrigger=PropertyChanged}" />
              <Button Grid.Column="2" Content="{DynamicResource S_Svc_Parcourir}" Padding="12,3"
                      Command="{Binding BrowseCommand}" CommandParameter="qpdf" />
            </Grid>
            <TextBlock Style="{StaticResource Hint}"
                       Text="{DynamicResource S_Svc_RepareLesPdfQue}" />

            <TextBlock Text="{DynamicResource S_Svc_RepertoireDesPolices}" Style="{StaticResource Label}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0" FontFamily="Consolas"
                       Text="{Binding FontDirectory, UpdateSourceTrigger=PropertyChanged}" />
              <Button Grid.Column="2" Content="{DynamicResource S_Svc_Parcourir}" Padding="12,3"
                      Command="{Binding BrowseCommand}" CommandParameter="fonts" />
            </Grid>
            <TextBlock Style="{StaticResource Hint}"
                       Text="{DynamicResource S_Svc_LesPolicesSontIncorporees}" />

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{DynamicResource S_Svc_Maintenance}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16">

            <TextBlock Text="{DynamicResource S_Svc_PeriodeEntreDeuxPasses}" Style="{StaticResource Label}" />
            <mah:NumericUpDown Value="{Binding MaintenanceIntervalMinutes}" Minimum="5" Maximum="1440"
                               Width="120" HorizontalAlignment="Left" />

            <TextBlock Text="{DynamicResource S_Svc_MiseEnQuarantaineApres}" Style="{StaticResource Label}" />
            <mah:NumericUpDown Value="{Binding QuarantineAfterDays}" Minimum="1" Maximum="365"
                               Width="120" HorizontalAlignment="Left" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="{DynamicResource S_Svc_UneUniteDeTravail}" />

            <TextBlock Text="{DynamicResource S_Svc_SeuilDAlerteD}" Style="{StaticResource Label}" />
            <mah:NumericUpDown Value="{Binding LowDiskThresholdPercent}" Minimum="1" Maximum="90"
                               Width="120" HorizontalAlignment="Left" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="{DynamicResource S_Svc_EnDessousUneAlerte}" />

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{DynamicResource S_Svc_Pilotage}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16">

            <CheckBox Content="{DynamicResource S_Svc_ActiverLApiDe}" IsChecked="{Binding ControlApiEnabled}" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="{DynamicResource S_Svc_LaDesactiverRendCette}" />

            <TextBlock Text="{DynamicResource S_Svc_PortDEcoute}" Style="{StaticResource Label}" />
            <mah:NumericUpDown Value="{Binding ControlApiPort}" Minimum="1024" Maximum="65535"
                               Width="120" HorizontalAlignment="Left" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="{DynamicResource S_Svc_EcouteUniquementSurLa}" />

            <TextBlock Text="{DynamicResource S_Svc_JetonDePilotageVide}" Style="{StaticResource Label}" />
            <TextBox Text="{Binding ControlApiToken, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="Consolas" />
            <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#C9942B" Margin="0,4,0,0"
                       Text="{DynamicResource S_Svc_ChangerLeJetonInvalide}" />

            <TextBlock Text="{DynamicResource S_Svc_BaseDeMetriquesVide}" Style="{StaticResource Label}" />
            <TextBox Text="{Binding MetricsConnectionString, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="Consolas" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="{DynamicResource S_Svc_ChaineDeConnexionSql}" />

          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="4,12,0,0">
      <TextBlock.Style>
        <Style TargetType="TextBlock">
          <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Text}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
              <Setter Property="Foreground" Value="#E04A4A" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>

    <ItemsControl Grid.Row="3" ItemsSource="{Binding Issues}" Margin="4,6,0,0">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <TextBlock TextWrapping="Wrap" Margin="0,2" Foreground="#E04A4A">
            <Run Text="{Binding Path, Mode=OneWay}" FontFamily="Consolas" FontSize="11" />
            <Run Text=" " />
            <Run Text="{Binding Message, Mode=OneWay}" />
          </TextBlock>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <mah:ProgressRing Width="18" Height="18" Margin="0,0,12,0" IsActive="{Binding IsBusy}" />
      <Button Content="{DynamicResource S_Svc_Fermer}" IsCancel="True"
              Style="{StaticResource MahApps.Styles.Button.Square}" Padding="20,6" />
      <Button Content="{DynamicResource S_Svc_Enregistrer}" Click="OnSave"
              IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
              Style="{StaticResource MahApps.Styles.Button.Square.Accent}"
              Padding="20,6" Margin="8,0,0,0" />
    </StackPanel>
  </Grid>
</mah:MetroWindow>
