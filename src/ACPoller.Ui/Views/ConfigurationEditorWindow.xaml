<mah:MetroWindow x:Class="ACPoller.Ui.Views.ConfigurationEditorWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:vm="clr-namespace:ACPoller.Ui.ViewModels"
                 Title="Configuration"
                 Height="820"
                 Width="960"
                 WindowStartupLocation="CenterOwner"
                 TitleCharacterCasing="Normal">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- Infobulles larges et multilignes : les explications utiles ne tiennent
         pas sur une ligne, et une infobulle tronquee ne sert a rien. -->
    <Style TargetType="ToolTip">
      <Setter Property="MaxWidth" Value="420" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="ContentTemplate">
        <Setter.Value>
          <DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="FrameworkElement">
      <Setter Property="ToolTipService.ShowDuration" Value="30000" />
      <Setter Property="ToolTipService.InitialShowDelay" Value="400" />
    </Style>

    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,10,0,3" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Opacity" Value="0.75" />
    </Style>

    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,18,0,8" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TabControl Grid.Row="0">

      <!-- GENERAL -->
      <TabItem Header="{DynamicResource S_Edit_General}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16">
            <TextBlock Text="{DynamicResource S_Edit_Nom}" Style="{StaticResource Label}" />
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="14"
                       ToolTip="{DynamicResource H_Name}" />

            <CheckBox Content="{DynamicResource S_Edit_ConfigurationActive}"
                      IsChecked="{Binding Enabled}" Margin="0,14,0,0"
                       ToolTip="{DynamicResource H_Enabled}" />

            <StackPanel Visibility="{Binding IsConfiguration, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="{DynamicResource S_Edit_GabaritDontHeriter}" Style="{StaticResource Label}" />
              <ComboBox ItemsSource="{Binding AvailableTemplates}"
                        SelectedItem="{Binding Template}"
                        Width="280" HorizontalAlignment="Left"
                        ToolTip="{DynamicResource H_Template}" />
              <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.6" Margin="0,4,0,0"
                         Text="{DynamicResource S_Edit_LaisserVidePourUne}" />
            </StackPanel>

            <Border Visibility="{Binding IsTemplate, Converter={StaticResource BoolToVisibility}}"
                    Background="#33C9942B" Padding="12,8" Margin="0,10,0,0" CornerRadius="3">
              <TextBlock TextWrapping="Wrap" FontSize="11"
                         Text="{DynamicResource S_Edit_CeGabaritEstUn}" />
            </Border>

            <TextBlock Text="{DynamicResource S_Edit_Collecte}" Style="{StaticResource Section}" />

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0">
                <TextBlock Text="{DynamicResource S_Edit_PeriodeEntreDeuxCycles}" Style="{StaticResource Label}" />
                <mah:NumericUpDown Value="{Binding IntervalSeconds}"
                       ToolTip="{DynamicResource H_Interval}" Minimum="5" Maximum="86400" />
              </StackPanel>

              <StackPanel Grid.Column="2">
                <!-- Le decalage evite que cent workers frappent le serveur a la
                     meme seconde au demarrage du service. -->
                <TextBlock Text="{DynamicResource S_Edit_DecalageAleatoireAuDemarrage}" Style="{StaticResource Label}" />
                <mah:NumericUpDown Value="{Binding StartupJitterSeconds}"
                       ToolTip="{DynamicResource H_Jitter}" Minimum="0" Maximum="600" />
              </StackPanel>
            </Grid>

            <CheckBox Content="{DynamicResource S_Edit_NePrendreQueLes}"
                      IsChecked="{Binding UnreadOnly}"
                       ToolTip="{DynamicResource H_UnreadOnly}" Margin="0,14,0,0" />

            <TextBlock Text="{DynamicResource S_Edit_NombreMaximalDeMessages}" Style="{StaticResource Label}" />
            <mah:NumericUpDown Value="{Binding MaxCount}"
                       ToolTip="{DynamicResource H_MaxCount}" Minimum="1" Maximum="5000" />

            <!-- Plancher absolu : sans lui, une premiere mise en service
                 traite tout l'historique dormant dans la boite. -->
            <CheckBox Content="{DynamicResource S_Edit_NePrendreQueLes2}"
                      IsChecked="{Binding RequireAttachments}" Margin="0,14,0,0"
                      ToolTip="{DynamicResource H_RequireAttachments}" />

            <TextBlock Text="{DynamicResource S_Edit_RattrapageAuPremierCycle}" Style="{StaticResource Label}" />
            <mah:NumericUpDown Value="{Binding InitialLookbackDays}" Minimum="0" Maximum="3650"
                               Width="120" HorizontalAlignment="Left"
                               ToolTip="{DynamicResource H_InitialLookback}" />
            <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.6" Margin="0,4,0,0"
                       Text="{DynamicResource S_Edit_AuToutPremierCycle}" />

            <TextBlock Text="{DynamicResource S_Edit_NeJamaisTraiterLes}" Style="{StaticResource Label}" />
            <DatePicker SelectedDate="{Binding NotBefore}"
                       ToolTip="{DynamicResource H_NotBefore}" />
            <TextBlock Text="{DynamicResource S_Edit_ARenseignerALa}"
                       FontSize="10" Opacity="0.6" TextWrapping="Wrap" Margin="0,4,0,0" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- PROTOCOLE -->
      <TabItem Header="{DynamicResource S_Edit_Protocole}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16">
            <TextBlock Text="{DynamicResource S_Edit_Protocole}" Style="{StaticResource Label}" />
            <ComboBox ItemsSource="{Binding Source={x:Static vm:ConfigurationFormViewModel.Protocols}}"
                      SelectedItem="{Binding Protocol}"
                       ToolTip="{DynamicResource H_Protocol}" Width="220" HorizontalAlignment="Left" />

            <TextBlock Text="{DynamicResource S_Edit_BoiteIdentifiantDuJournal}" Style="{StaticResource Label}" />
            <TextBox Text="{Binding Mailbox, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="{DynamicResource H_Mailbox}" />

            <!-- Graph -->
            <StackPanel Visibility="{Binding IsGraph, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="{DynamicResource S_Edit_MicrosoftGraph}" Style="{StaticResource Section}" />

              <TextBlock Text="{DynamicResource S_Edit_Tenantid}" Style="{StaticResource Label}" />
              <TextBox Text="{Binding TenantId, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />

              <TextBlock Text="{DynamicResource S_Edit_Clientid}" Style="{StaticResource Label}" />
              <TextBox Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />

              <TextBlock Text="{DynamicResource S_Edit_SecretClientVideInchange}" Style="{StaticResource Label}" />
              <TextBox Text="{Binding ClientSecret, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="{DynamicResource H_ClientSecret}" FontFamily="Consolas" />

              <TextBlock Text="{DynamicResource S_Edit_EmpreinteDeCertificatPreferable}" Style="{StaticResource Label}" />
              <TextBox Text="{Binding CertificateThumbprint, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="{DynamicResource H_Certificate}"
                       FontFamily="Consolas" />
              <TextBlock Text="{DynamicResource S_Edit_UnCertificatNExpire}"
                         FontSize="10" Opacity="0.6" Margin="0,4,0,0" />

              <TextBlock Text="{DynamicResource S_Edit_LimitationDeDebit}" Style="{StaticResource Section}" />

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <TextBlock Text="{DynamicResource S_Edit_RequetesSimultanees}" Style="{StaticResource Label}" />
                  <mah:NumericUpDown Value="{Binding ThrottleMaxConcurrent}" Minimum="1" Maximum="64" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                  <TextBlock Text="{DynamicResource S_Edit_EspacementMinimalMs}" Style="{StaticResource Label}" />
                  <mah:NumericUpDown Value="{Binding ThrottleMinSpacingMs}" Minimum="0" Maximum="10000" />
                </StackPanel>
              </Grid>

              <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.6" Margin="0,6,0,0"
                         Text="{DynamicResource S_Edit_CesBornesSontPartagees}" />

              <CheckBox Content="{DynamicResource S_Edit_RespecterLeDelaiDemande}"
                        IsChecked="{Binding HonorRetryAfter}" Margin="0,12,0,0"
                        ToolTip="{DynamicResource H_HonorRetryAfter}" />
            </StackPanel>

            <!-- IMAP -->
            <StackPanel Visibility="{Binding IsImap, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="{DynamicResource S_Edit_Imap}" Style="{StaticResource Section}" />

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <TextBlock Text="{DynamicResource S_Edit_Hote}" Style="{StaticResource Label}" />
                  <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                  <TextBlock Text="{DynamicResource S_Edit_Port}" Style="{StaticResource Label}" />
                  <mah:NumericUpDown Value="{Binding Port}" Minimum="1" Maximum="65535" />
                </StackPanel>
              </Grid>

              <CheckBox Content="{DynamicResource S_Edit_SslImpliciteDecocherPour}"
                        IsChecked="{Binding UseSsl}" Margin="0,12,0,0" />

              <TextBlock Text="{DynamicResource S_Edit_Utilisateur}" Style="{StaticResource Label}" />
              <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />

              <TextBlock Text="{DynamicResource S_Edit_MotDePasseVide}" Style="{StaticResource Label}" />
              <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
            </StackPanel>

            <!-- Repertoire -->
            <StackPanel Visibility="{Binding IsFolder, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="{DynamicResource S_Edit_RepertoireLocal}" Style="{StaticResource Section}" />

              <TextBlock Text="{DynamicResource S_Edit_CheminDesFichiersEml}" Style="{StaticResource Label}" />
              <TextBox Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Text="{DynamicResource S_Edit_SertAuRejeuD}"
                         FontSize="10" Opacity="0.6" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>

            <TextBlock Text="{DynamicResource S_Edit_DossierEtDisposition}" Style="{StaticResource Section}" />

            <TextBlock Text="{DynamicResource S_Edit_DossierSurveille}" Style="{StaticResource Label}" />
            <ComboBox ItemsSource="{Binding Source={x:Static vm:ConfigurationFormViewModel.WellKnownFolders}}"
                      SelectedItem="{Binding Folder}"
                       ToolTip="{DynamicResource H_Folder}" Width="220" HorizontalAlignment="Left" />
            <TextBlock Text="{DynamicResource S_Edit_NomCanoniqueEtNon}"
                       FontSize="10" Opacity="0.6" Margin="0,4,0,0" />

            <TextBlock Text="{DynamicResource S_Edit_ApresTraitement}" Style="{StaticResource Label}" />
            <ComboBox ItemsSource="{Binding Source={x:Static vm:ConfigurationFormViewModel.Dispositions}}"
                      SelectedItem="{Binding Disposition}"
                       ToolTip="{DynamicResource H_Disposition}" Width="220" HorizontalAlignment="Left" />

            <TextBlock Text="{DynamicResource S_Edit_DossierDeDestinationSi}" Style="{StaticResource Label}" />
            <ComboBox ItemsSource="{Binding Source={x:Static vm:ConfigurationFormViewModel.WellKnownFolders}}"
                      SelectedItem="{Binding TargetFolder}" Width="220" HorizontalAlignment="Left" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- CONVERSION -->
      <TabItem Header="{DynamicResource S_Edit_Conversion}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16">
            <TextBlock Text="{DynamicResource S_Edit_DelaiMaximalParPiece}" Style="{StaticResource Label}" />
            <mah:NumericUpDown Value="{Binding TimeoutMinutes}"
                       ToolTip="{DynamicResource H_Timeout}" Minimum="1" Maximum="60"
                               Width="120" HorizontalAlignment="Left" />
            <TextBlock Text="{DynamicResource S_Edit_DepasseLeConvertisseurEst}"
                       FontSize="10" Opacity="0.6" Margin="0,4,0,0" />

            <TextBlock Text="{DynamicResource S_Edit_PieceNonConvertible}" Style="{StaticResource Label}" />
            <ComboBox ItemsSource="{Binding Source={x:Static vm:ConfigurationFormViewModel.FailurePolicies}}"
                      SelectedItem="{Binding OnFailure}"
                       ToolTip="{DynamicResource H_OnFailure}" Width="220" HorizontalAlignment="Left" />
            <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.6" Margin="0,4,0,0"
                       Text="{DynamicResource S_Edit_SubstituteProduitUnePage}" />

            <CheckBox Content="{DynamicResource S_Edit_ConvertirLeCorpsDu}"
                      IsChecked="{Binding IncludeBody}" Margin="0,16,0,0" />

            <CheckBox Content="{DynamicResource S_Edit_JoindreAussiLesPieces}"
                      IsChecked="{Binding KeepOriginals}" Margin="0,8,0,0" />

            <TextBlock Text="{DynamicResource S_Edit_TailleMinimaleDUne}" Style="{StaticResource Label}" />
            <mah:NumericUpDown Value="{Binding MinInlineImageKilobytes}"
                       ToolTip="{DynamicResource H_MinInlineImage}" Minimum="0" Maximum="10240"
                               Width="120" HorizontalAlignment="Left" />
            <TextBlock Text="{DynamicResource S_Edit_EnDessousLImage}"
                       FontSize="10" Opacity="0.6" Margin="0,4,0,0" />

            <TextBlock Text="{DynamicResource S_Edit_ExtractionRecursive}" Style="{StaticResource Section}" />

            <TextBlock Text="{DynamicResource S_Edit_ProfondeurMaximale}" Style="{StaticResource Label}" />
            <mah:NumericUpDown Value="{Binding MaxDepth}"
                       ToolTip="{DynamicResource H_ExtractionLimits}" Minimum="1" Maximum="20"
                               Width="120" HorizontalAlignment="Left" />

            <TextBlock Text="{DynamicResource S_Edit_NombreMaximalDePieces}" Style="{StaticResource Label}" />
            <mah:NumericUpDown Value="{Binding MaxNodes}" Minimum="1" Maximum="10000"
                               Width="120" HorizontalAlignment="Left" />
            <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.6" Margin="0,4,0,0"
                       Text="{DynamicResource S_Edit_CesBornesProtegentD}" />

            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0">
                <TextBlock Text="{DynamicResource S_Edit_VolumeDecompresseMaximalMo}" Style="{StaticResource Label}" />
                <mah:NumericUpDown Value="{Binding MaxExpandedMegabytes}" Minimum="1" Maximum="10240" />
              </StackPanel>

              <StackPanel Grid.Column="2">
                <TextBlock Text="{DynamicResource S_Edit_TailleMaximaleDUne}" Style="{StaticResource Label}" />
                <mah:NumericUpDown Value="{Binding MaxSingleEntryMegabytes}" Minimum="1" Maximum="10240" />
              </StackPanel>
            </Grid>

            <TextBlock Text="{DynamicResource S_Edit_ExtensionsEcartees}" Style="{StaticResource Label}" />
            <TextBox Text="{Binding ExcludedExtensions, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="Consolas"
                     ToolTip="{DynamicResource H_ExcludedExtensions}" />
            <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.6" Margin="0,4,0,0"
                       Text="{DynamicResource S_Edit_SepareesParDesVirgules}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- SORTIE -->
      <TabItem Header="{DynamicResource S_Edit_FormatDeSortie}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16">
            <TextBlock Text="{DynamicResource S_Edit_ModeDeProductionDes}" Style="{StaticResource Label}" />
            <ComboBox ItemsSource="{Binding Source={x:Static vm:ConfigurationFormViewModel.PdfModes}}"
                      SelectedItem="{Binding PdfMode}"
                       ToolTip="{DynamicResource H_PdfMode}" Width="220" HorizontalAlignment="Left" />

            <TextBlock Text="{DynamicResource S_Edit_FormatDuFichierD}" Style="{StaticResource Label}" />
            <ComboBox ItemsSource="{Binding Source={x:Static vm:ConfigurationFormViewModel.MetadataFormats}}"
                      SelectedItem="{Binding MetadataFormat}"
                       ToolTip="{DynamicResource H_MetadataFormat}" Width="220" HorizontalAlignment="Left" />
            <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.6" Margin="0,4,0,0"
                       Text="{DynamicResource S_Edit_XsltAppliqueUneFeuille}" />

            <StackPanel Visibility="{Binding IsXslt, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="{DynamicResource S_Edit_FeuilleDeTransformation}" Style="{StaticResource Label}" />

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding MetadataTemplate, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="Consolas" />

                <Button Grid.Column="2" Content="{DynamicResource S_Edit_Parcourir}"
                        Command="{Binding BrowseStylesheetCommand}" Padding="12,3" />
              </Grid>

              <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.6" Margin="0,4,0,0"
                         Text="{DynamicResource S_Edit_CheminSurLeServeur}" />

              <TextBlock Text="{DynamicResource S_Edit_ExtensionDuFichierProduit}" Style="{StaticResource Label}" />
              <TextBox Text="{Binding MetadataExtension, UpdateSourceTrigger=PropertyChanged}"
                       Width="140" HorizontalAlignment="Left" FontFamily="Consolas" />
              <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.6" Margin="0,4,0,0"
                         Text="{DynamicResource S_Edit_VideDonneXmlUne}" />

              <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#C9942B" Margin="0,10,0,0"
                         Text="{DynamicResource S_Edit_MiseAuPointPasser}" />
            </StackPanel>

            <TextBlock Text="{DynamicResource S_Edit_GabaritDeNommage}" Style="{StaticResource Label}" />
            <TextBox Text="{Binding Naming, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="{DynamicResource H_Naming}" FontFamily="Consolas" />
            <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.6" Margin="0,4,0,0"
                       Text="{DynamicResource S_Edit_JetonsDisponibles}" />

            <TextBlock Text="{DynamicResource S_Edit_PolitiqueDeDepot}" Style="{StaticResource Section}" />

            <CheckBox Content="{DynamicResource S_Edit_EcritureAtomiqueFichierTemporaire}"
                      IsChecked="{Binding AtomicWrite}"
                       ToolTip="{DynamicResource H_AtomicWrite}" />
            <TextBlock Text="{DynamicResource S_Edit_SansElleLaGed}"
                       FontSize="10" Opacity="0.6" Margin="22,2,0,0" />

            <CheckBox Content="{DynamicResource S_Edit_ToutOuRienEntre}"
                      IsChecked="{Binding AllOrNothing}"
                       ToolTip="{DynamicResource H_AllOrNothing}" Margin="0,12,0,0" />
            <TextBlock Text="{DynamicResource S_Edit_UnEchecSurUne}"
                       FontSize="10" Opacity="0.6" Margin="22,2,0,0" />

            <TextBlock Text="{DynamicResource S_Edit_FichierTemoinEcritEn}" Style="{StaticResource Label}" />
            <TextBox Text="{Binding SentinelFileName, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="{DynamicResource H_Sentinel}"
                     FontFamily="Consolas" />

            <TextBlock Text="{DynamicResource S_Edit_TentativesSurEchecTransitoire}" Style="{StaticResource Label}" />
            <mah:NumericUpDown Value="{Binding MaxAttempts}" Minimum="1" Maximum="20"
                               Width="120" HorizontalAlignment="Left" />

            <TextBlock Text="{DynamicResource S_Edit_DelaiAvantLaSeconde}" Style="{StaticResource Label}" />
            <mah:NumericUpDown Value="{Binding InitialBackoffSeconds}" Minimum="1" Maximum="600"
                               Width="120" HorizontalAlignment="Left" />
            <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.6" Margin="0,4,0,0"
                       Text="{DynamicResource S_Edit_DoubleAChaqueNouvel}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- CIBLES -->
      <TabItem Header="{DynamicResource S_Edit_Traitements}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16">

            <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7" Margin="0,0,0,12"
                       Text="{DynamicResource S_Edit_TraitementsMetierApportesPar}" />

            <ItemsControl ItemsSource="{Binding AvailableProcessors}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Padding="10,8" Margin="0,0,0,6" CornerRadius="3"
                          BorderThickness="1"
                          BorderBrush="{DynamicResource MahApps.Brushes.Gray8}">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Style.Triggers>
                          <!-- Un processeur declare mais dont le plugin n'est
                               plus charge doit se voir : il ne s'executera
                               pas, et le service ecartera la configuration au
                               prochain demarrage. -->
                          <DataTrigger Binding="{Binding IsMissing}" Value="True">
                            <Setter Property="BorderBrush" Value="#E04A4A" />
                            <Setter Property="Background" Value="#22E04A4A" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>

                    <DockPanel>
                      <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsSelected}"
                                VerticalAlignment="Center" Margin="0,0,10,0" />

                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Stages}" FontSize="10" Opacity="0.7" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.6" Margin="0,8,0,0"
                       Text="{DynamicResource S_Edit_AucunTraitementMetierDisponible}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding AvailableProcessors.Count}" Value="0">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>

            <StackPanel Visibility="{Binding HasRejectedPlugins, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="{DynamicResource S_Edit_PluginsRefuses}" Style="{StaticResource Section}" />
              <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.7" Margin="0,0,0,8"
                         Text="{DynamicResource S_Edit_CesAssemblagesSontPresents}" />

              <ItemsControl ItemsSource="{Binding RejectedPlugins}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock TextWrapping="Wrap" Margin="0,3" Foreground="#C9942B">
                      <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                      <Run Text=" " />
                      <Run Text="{Binding Reason, Mode=OneWay}" />
                    </TextBlock>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{DynamicResource S_Edit_Cibles}">
        <Grid Margin="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="200" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" MinWidth="320" />
          </Grid.ColumnDefinitions>

          <GridSplitter Grid.Column="1" Width="6"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="Transparent" />

          <DockPanel Grid.Column="0" Margin="0,0,10,0">
            <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,8,0,0">
              <Button Content="{DynamicResource S_Edit_Ajouter}" Command="{Binding AddTargetCommand}" Margin="0,0,3,0" />
              <Button Content="{DynamicResource S_Edit_Retirer}" Command="{Binding RemoveTargetCommand}" Margin="3,0,0,0" />
            </UniformGrid>

            <ListBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,3">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Type}" FontSize="10" Opacity="0.7" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>

          <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                        DataContext="{Binding SelectedTarget}">
            <StackPanel>
              <TextBlock Text="{DynamicResource S_Edit_TypeDeTransport}" Style="{StaticResource Label}" />
              <ComboBox ItemsSource="{Binding Source={x:Static vm:TargetViewModel.Types}}"
                        SelectedItem="{Binding Type}"
                       ToolTip="{DynamicResource H_TargetType}" Width="180" HorizontalAlignment="Left" />

              <TextBlock Text="{DynamicResource S_Edit_NomDeLaCible}" Style="{StaticResource Label}" />
              <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Text="{DynamicResource S_Edit_ReprisDansLesJournaux}"
                         FontSize="10" Opacity="0.6" Margin="0,4,0,0" />

              <StackPanel Visibility="{Binding IsFileSystem, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{DynamicResource S_Edit_SystemeDeFichiers}" Style="{StaticResource Section}" />

                <TextBlock Text="{DynamicResource S_Edit_RepertoireDeDepotLocal}" Style="{StaticResource Label}" />
                <TextBox Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" />

                <CheckBox Content="{DynamicResource S_Edit_CreerLeRepertoireS}"
                          IsChecked="{Binding CreateDirectory}" Margin="0,12,0,0" />
              </StackPanel>

              <StackPanel Visibility="{Binding IsFtp, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{DynamicResource S_Edit_FtpFtps}" Style="{StaticResource Section}" />

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="110" />
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource S_Edit_Hote}" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>

                  <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource S_Edit_Port}" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                </Grid>

                <TextBlock Text="{DynamicResource S_Edit_Utilisateur}" Style="{StaticResource Label}" />
                <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="{DynamicResource S_Edit_MotDePasseVide}" Style="{StaticResource Label}" />
                <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />

                <TextBlock Text="{DynamicResource S_Edit_RepertoireDistant}" Style="{StaticResource Label}" />
                <TextBox Text="{Binding RemoteDirectory, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="{DynamicResource S_Edit_Chiffrement}" Style="{StaticResource Label}" />
                <ComboBox ItemsSource="{Binding Source={x:Static vm:TargetViewModel.EncryptionModes}}"
                          SelectedItem="{Binding EncryptionMode}" Width="180" HorizontalAlignment="Left" />

                <CheckBox Content="{DynamicResource S_Edit_AccepterToutCertificatServeur}"
                          IsChecked="{Binding AcceptAnyCertificate}"
                       ToolTip="{DynamicResource H_AcceptAnyCertificate}" Margin="0,12,0,0" />
                <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#C9942B" Margin="22,2,0,0"
                           Text="{DynamicResource S_Edit_SupprimeTouteProtectionContre}" />
              </StackPanel>

              <StackPanel Visibility="{Binding IsS3, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{DynamicResource S_Edit_S3OuCompatible}" Style="{StaticResource Section}" />

                <TextBlock Text="{DynamicResource S_Edit_Bucket}" Style="{StaticResource Label}" />
                <TextBox Text="{Binding Bucket, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="{DynamicResource S_Edit_PrefixeDesCles}" Style="{StaticResource Label}" />
                <TextBox Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />

                <TextBlock Text="{DynamicResource S_Edit_Region}" Style="{StaticResource Label}" />
                <TextBox Text="{Binding Region, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="{DynamicResource S_Edit_PointDAccesPersonnalise}" Style="{StaticResource Label}" />
                <TextBox Text="{Binding ServiceUrl, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="{DynamicResource H_S3ServiceUrl}" />
                <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.6" Margin="0,4,0,0"
                           Text="{DynamicResource S_Edit_RenseigneLeStyleChemin}" />

                <TextBlock Text="{DynamicResource S_Edit_CleDAccesVide}" Style="{StaticResource Label}" />
                <TextBox Text="{Binding AccessKey, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />

                <TextBlock Text="{DynamicResource S_Edit_CleSecreteVideInchange}" Style="{StaticResource Label}" />
                <TextBox Text="{Binding SecretKey, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />

                <TextBlock Text="{DynamicResource S_Edit_ChiffrementAuRepos}" Style="{StaticResource Label}" />
                <TextBox Text="{Binding ServerSideEncryption, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="{DynamicResource H_S3Encryption}" />
                <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.6" Margin="0,4,0,0"
                           Text="{DynamicResource S_Edit_Aes256SurAwsLaisser}" />
              </StackPanel>

              <StackPanel Visibility="{Binding IsPlugin, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{DynamicResource S_Edit_DllDExportCliente}" Style="{StaticResource Section}" />

                <TextBlock Text="{DynamicResource S_Edit_Assemblage}" Style="{StaticResource Label}" />
                <TextBox Text="{Binding Assembly, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.6" Margin="0,4,0,0"
                           Text="{DynamicResource S_Edit_LesReglagesPropresAu}" />
              </StackPanel>

              <TextBlock Text="{DynamicResource S_Edit_TousLesReglages}" Style="{StaticResource Section}" />
              <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.6" Margin="0,0,0,8"
                         Text="{DynamicResource S_Edit_LesChampsCiDessus}" />

              <DataGrid ItemsSource="{Binding Settings}"
                        AutoGenerateColumns="False"
                        CanUserAddRows="True"
                        HeadersVisibility="Column"
                        GridLinesVisibility="Horizontal"
                        MinHeight="160">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="{DynamicResource S_Edit_Reglage}" Binding="{Binding Key}" Width="200" />
                  <DataGridTextColumn Header="{DynamicResource S_Edit_Valeur}" Binding="{Binding Value}" Width="*" />
                </DataGrid.Columns>
              </DataGrid>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <TabItem Header="{DynamicResource S_Edit_Champs}">
        <Grid Margin="16">
          <Grid.ColumnDefinitions>
            <!-- Largeur ajustable : la longueur des noms de champs varie
                 beaucoup d'un client a l'autre, une largeur figee ne convient
                 a personne. MinWidth evite de faire disparaitre la liste. -->
            <ColumnDefinition Width="320" MinWidth="220" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" MinWidth="320" />
          </Grid.ColumnDefinitions>

          <GridSplitter Grid.Column="1" Width="6"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="Transparent" />

          <DockPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="10" Opacity="0.6"
                       Margin="0,0,0,8"
                       Text="{DynamicResource S_Edit_LOrdreFaitFoi}" />

            <!-- Deux rangees de deux : quatre boutons cote a cote debordent des
                 que la colonne est reduite. -->
            <UniformGrid DockPanel.Dock="Bottom" Columns="2" Rows="2" Margin="0,8,0,0">
              <Button Content="{DynamicResource S_Edit_Ajouter}" Command="{Binding AddFieldCommand}" Margin="0,0,3,3" />
              <Button Content="{DynamicResource S_Edit_Retirer}" Command="{Binding RemoveFieldCommand}" Margin="3,0,0,3" />
              <Button Content="{DynamicResource S_Edit_Monter}" Command="{Binding MoveFieldUpCommand}" Margin="0,3,3,0" />
              <Button Content="{DynamicResource S_Edit_Descendre}" Command="{Binding MoveFieldDownCommand}" Margin="3,3,0,0" />
            </UniformGrid>

            <ListBox ItemsSource="{Binding Fields}" SelectedItem="{Binding SelectedField}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,3">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock FontSize="10" Opacity="0.7">
                      <Run Text="{Binding Source, Mode=OneWay}" />
                      <Run Text=" " />
                      <Run Text="{Binding Value, Mode=OneWay}" />
                    </TextBlock>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>

          <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                        DataContext="{Binding SelectedField}">
            <StackPanel>
              <TextBlock Text="{DynamicResource S_Edit_NomDuChampEn}" Style="{StaticResource Label}" />
              <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

              <TextBlock Text="{DynamicResource S_Edit_OrigineDeLaValeur}" Style="{StaticResource Label}" />
              <ComboBox ItemsSource="{Binding Source={x:Static vm:MetadataFieldViewModel.Sources}}"
                        SelectedItem="{Binding Source}"
                       ToolTip="{DynamicResource H_FieldSource}" Width="180" HorizontalAlignment="Left" />

              <TextBlock Text="{DynamicResource S_Edit_Valeur}" Style="{StaticResource Label}" />
              <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
              <TextBlock Text="{Binding ValueHint}" TextWrapping="Wrap"
                         FontSize="10" Opacity="0.6" Margin="0,4,0,0" />

              <TextBlock Text="{DynamicResource S_Edit_FormatDeDateIgnore}" Style="{StaticResource Label}" />
              <TextBox Text="{Binding Format, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"
                       Width="200" HorizontalAlignment="Left" />

              <TextBlock Text="{DynamicResource S_Edit_ValeurParDefautSi}" Style="{StaticResource Label}" />
              <TextBox Text="{Binding Default, UpdateSourceTrigger=PropertyChanged}"
                       Width="200" HorizontalAlignment="Left" />

              <TextBlock Text="{DynamicResource S_Edit_LongueurFixe0Libre}" Style="{StaticResource Label}" />
              <Grid HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <mah:NumericUpDown Grid.Column="0" Value="{Binding FixedLength}"
                       ToolTip="{DynamicResource H_FieldFixedLength}" Minimum="0" Maximum="500" />
                <CheckBox Grid.Column="2" Content="{DynamicResource S_Edit_RemplirAGauche}"
                          IsChecked="{Binding PadLeft}" VerticalAlignment="Center" />
              </Grid>
              <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.6" Margin="0,4,0,0"
                         Text="{DynamicResource S_Edit_PourLesGedQui}" />

              <TextBlock Text="{DynamicResource S_Edit_TraductionsDeValeur}" Style="{StaticResource Section}" />
              <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.6" Margin="0,0,0,8"
                         Text="{DynamicResource S_Edit_AppliqueesApresResolutionConvertit}" />

              <DataGrid ItemsSource="{Binding Values}"
                       ToolTip="{DynamicResource H_FieldValues}"
                        AutoGenerateColumns="False"
                        CanUserAddRows="True"
                        HeadersVisibility="Column"
                        GridLinesVisibility="Horizontal"
                        MinHeight="140">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="{DynamicResource S_Edit_ValeurLue}" Binding="{Binding From}" Width="*" />
                  <DataGridTextColumn Header="{DynamicResource S_Edit_ValeurEcrite}" Binding="{Binding To}" Width="*" />
                </DataGrid.Columns>
              </DataGrid>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <TabItem Header="{DynamicResource S_Edit_Json}">
        <DockPanel Margin="16">
          <Button DockPanel.Dock="Top" Content="{DynamicResource S_Edit_RafraichirLApercu}"
                  Command="{Binding RefreshPreviewCommand}"
                  HorizontalAlignment="Left" Padding="12,4" Margin="0,0,0,10" />

          <!-- Lecture seule : le formulaire est la source, et un JSON edite en
               parallele produirait deux verites contradictoires. Les reglages
               exotiques passent par le tableau de l'onglet Cibles. -->
          <TextBox Text="{Binding JsonPreview, Mode=OneWay}"
                   IsReadOnly="True"
                   FontFamily="Consolas"
                   FontSize="12"
                   AcceptsReturn="True"
                   TextWrapping="NoWrap"
                   VerticalScrollBarVisibility="Auto"
                   HorizontalScrollBarVisibility="Auto" />
        </DockPanel>
      </TabItem>
    </TabControl>

    <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="4,12,0,0">
      <TextBlock.Style>
        <Style TargetType="TextBlock">
          <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Text}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
              <Setter Property="Foreground" Value="#E04A4A" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>

    <ItemsControl Grid.Row="2" ItemsSource="{Binding Issues}" Margin="4,6,0,0">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <TextBlock TextWrapping="Wrap" Margin="0,2" Foreground="#E04A4A">
            <Run Text="{Binding Path, Mode=OneWay}" FontFamily="Consolas" FontSize="11" />
            <Run Text=" " />
            <Run Text="{Binding Message, Mode=OneWay}" />
          </TextBlock>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <mah:ProgressRing Width="18" Height="18" Margin="0,0,12,0" IsActive="{Binding IsBusy}" />
      <Button Content="{DynamicResource S_Edit_Fermer}" IsCancel="True"
              Style="{StaticResource MahApps.Styles.Button.Square}" Padding="20,6" />
      <Button Content="{DynamicResource S_Edit_Enregistrer}" Click="OnSave"
              IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
              Style="{StaticResource MahApps.Styles.Button.Square.Accent}"
              Padding="20,6" Margin="8,0,0,0" />
    </StackPanel>
  </Grid>
</mah:MetroWindow>
