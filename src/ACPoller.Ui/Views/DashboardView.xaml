<UserControl x:Class="ACPoller.Ui.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls">

  <UserControl.Resources>
    <!-- Carte d'indicateur. Le chiffre en grand, le libelle en petit : sur un
         ecran d'exploitation, on lit les chiffres de loin et les libelles
         seulement quand un chiffre surprend. -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Gray10}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray8}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="Margin" Value="0,0,10,10" />
      <Setter Property="MinWidth" Value="150" />
    </Style>

    <Style x:Key="Figure" TargetType="TextBlock">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="Light" />
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="Margin" Value="0,2,0,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,20,0,10" />
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20">

      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Remettre a zero"
                Command="{Binding ResetCommand}"
                Style="{StaticResource MahApps.Styles.Button.Square}" Padding="12,4" />
        <TextBlock Text="{Binding WindowLabel}" VerticalAlignment="Center"
                   FontSize="12" Opacity="0.7" />
      </DockPanel>

      <TextBlock Text="Traitement" Style="{StaticResource Section}" />

      <WrapPanel>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="{Binding Data.Exported}" Style="{StaticResource Figure}"
                       Foreground="#2EA043" />
            <TextBlock Text="Messages exportes" Style="{StaticResource Caption}" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock >
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Figure}">
                  <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Text}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasFailures}" Value="True">
                      <Setter Property="Foreground" Value="#E04A4A" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
              <Run Text="{Binding Data.Failed, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Text="En echec" Style="{StaticResource Caption}" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource Figure}">
              <Run Text="{Binding Data.SuccessRate, Mode=OneWay}" />
              <Run Text="%" />
            </TextBlock>
            <TextBlock Text="Taux de succes" Style="{StaticResource Caption}" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="{Binding Data.Rejected}" Style="{StaticResource Figure}" />
            <TextBlock Text="Rejetes par un traitement metier" Style="{StaticResource Caption}" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="{Binding Data.Skipped}" Style="{StaticResource Figure}" />
            <TextBlock Text="Ecartes" Style="{StaticResource Caption}" />
          </StackPanel>
        </Border>
      </WrapPanel>

      <TextBlock Text="Performance et sante" Style="{StaticResource Section}" />

      <WrapPanel>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource Figure}">
              <Run Text="{Binding Data.AverageDurationMs, Mode=OneWay}" />
              <Run Text="ms" FontSize="14" />
            </TextBlock>
            <TextBlock Text="Duree moyenne" Style="{StaticResource Caption}" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource Figure}">
              <Run Text="{Binding Data.P95DurationMs, Mode=OneWay}" />
              <Run Text="ms" FontSize="14" />
            </TextBlock>
            <!-- Le P95 dit ce que la moyenne cache : les messages lents
                 saturent les slots de concurrence. -->
            <TextBlock Text="95e centile. Ecart important avec la moyenne : des messages saturent les slots."
                       Style="{StaticResource Caption}" MaxWidth="180" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock>
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Figure}">
                  <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Text}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasThrottling}" Value="True">
                      <Setter Property="Foreground" Value="#C9942B" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
              <Run Text="{Binding Data.ThrottleEvents, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Text="Limitations Graph. Non nul en regime etabli : reduire la concurrence."
                       Style="{StaticResource Caption}" MaxWidth="180" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock>
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Figure}">
                  <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Text}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasDiskWarning}" Value="True">
                      <Setter Property="Foreground" Value="#E04A4A" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
              <Run Text="{Binding Data.FreeDiskPercent, Mode=OneWay}" />
              <Run Text="%" />
            </TextBlock>
            <TextBlock Text="Disque libre. A saturation, la capture s'arrete."
                       Style="{StaticResource Caption}" MaxWidth="180" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="{Binding Data.ConversionFailures}" Style="{StaticResource Figure}" />
            <TextBlock Text="Pieces non converties" Style="{StaticResource Caption}" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="{Binding Data.CycleErrors}" Style="{StaticResource Figure}" />
            <TextBlock Text="Cycles en erreur" Style="{StaticResource Caption}" />
          </StackPanel>
        </Border>
      </WrapPanel>

      <TextBlock Text="Volume par heure" Style="{StaticResource Section}" />

      <Border BorderBrush="{DynamicResource MahApps.Brushes.Gray8}" BorderThickness="0,0,0,1"
              Padding="0,0,0,4">
        <ItemsControl ItemsSource="{Binding HourlyBars}" Height="140">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>

          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel VerticalAlignment="Bottom" Margin="2,0" Width="28"
                          ToolTip="{Binding ToolTip}">
                <Rectangle Height="{Binding Height}"
                           Fill="{DynamicResource MahApps.Brushes.Accent}"
                           VerticalAlignment="Bottom" />
                <TextBlock Text="{Binding Label}" FontSize="9" Opacity="0.6"
                           HorizontalAlignment="Center" Margin="0,4,0,0" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <TextBlock Text="Par configuration" Style="{StaticResource Section}" />

      <DataGrid ItemsSource="{Binding ByConfiguration}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                HeadersVisibility="Column"
                GridLinesVisibility="Horizontal"
                BorderThickness="0"
                Background="Transparent"
                RowBackground="Transparent"
                CanUserAddRows="False"
                MaxHeight="320">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Configuration" Binding="{Binding Name}" Width="*" />
          <DataGridTextColumn Header="Exportes" Binding="{Binding Exported}" Width="90" />
          <DataGridTextColumn Header="Echecs" Binding="{Binding Failed}" Width="80" />
          <DataGridTextColumn Header="Rejets" Binding="{Binding Rejected}" Width="80" />
          <DataGridTextColumn Header="Duree moy." Binding="{Binding AverageDurationMs, StringFormat={}{0} ms}"
                              Width="100" />
        </DataGrid.Columns>

        <DataGrid.RowStyle>
          <Style TargetType="DataGridRow">
            <Style.Triggers>
              <!-- Une boite en echec ressort dans la liste : c'est la premiere
                   chose qu'on cherche sur cet ecran. -->
              <DataTrigger Binding="{Binding Failed}" Value="0">
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Text}" />
              </DataTrigger>
            </Style.Triggers>
            <Setter Property="Foreground" Value="#E04A4A" />
          </Style>
        </DataGrid.RowStyle>
      </DataGrid>

    </StackPanel>
  </ScrollViewer>
</UserControl>
