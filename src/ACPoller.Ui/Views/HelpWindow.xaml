<mah:MetroWindow x:Class="ACPoller.Ui.Views.HelpWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 Title="Aide"
                 Height="720"
                 Width="880"
                 WindowStartupLocation="CenterOwner"
                 TitleCharacterCasing="Normal">

  <Window.Resources>
    <Style x:Key="H1" TargetType="TextBlock">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,20,0,10" />
    </Style>

    <Style x:Key="P" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="Code" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
  </Window.Resources>

  <TabControl Margin="12">

    <TabItem Header="{DynamicResource S_Help_JetonsDeNommage}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
          <TextBlock Style="{StaticResource P}"
                     Text="{DynamicResource S_Help_JetonsIntro}" />

          <TextBlock Style="{StaticResource Code}" Text="{DynamicResource S_Help_TokenList}" />

          <TextBlock Style="{StaticResource H1}" Text="{DynamicResource S_Help_Assainissement}" />
          <TextBlock Style="{StaticResource P}" Text="{DynamicResource S_Help_TousLesCaracteresInterdits}" />
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <TabItem Header="{DynamicResource S_Help_StatutsDesPieces}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
          <TextBlock Style="{StaticResource P}" Text="{DynamicResource S_Help_LeFichierDInformation}" />

          <TextBlock Style="{StaticResource Code}" Text="{DynamicResource S_Help_StatusList}" />

          <TextBlock Style="{StaticResource H1}" Text="{DynamicResource S_Help_EnPratique}" />
          <TextBlock Style="{StaticResource P}" Text="{DynamicResource S_Help_UnLotOuFailedcount}" />
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <TabItem Header="{DynamicResource S_Help_ChampsPersonnalises}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
          <TextBlock Style="{StaticResource P}" Text="{DynamicResource S_Help_LesChampsAjoutesAu}" />

          <TextBlock Style="{StaticResource H1}" Text="{DynamicResource S_Help_Sources}" />
          <TextBlock Style="{StaticResource Code}" Text="{DynamicResource S_Help_SourceList}" />

          <TextBlock Style="{StaticResource H1}" Text="{DynamicResource S_Help_SortieSelonLeFormat}" />
          <TextBlock Style="{StaticResource Code}" Text="{DynamicResource S_Help_FormatList}" />

          <TextBlock Style="{StaticResource P}" Text="{DynamicResource S_Help_UnChampNonResolu}" />
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <TabItem Header="{DynamicResource S_Help_Diagnostic}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

          <TextBlock Style="{StaticResource H1}" Text="{DynamicResource S_Help_UnMessageRevientA}" />
          <TextBlock Style="{StaticResource P}" Text="{DynamicResource S_Help_LeMarquageNA}" />

          <TextBlock Style="{StaticResource H1}" Text="{DynamicResource S_Help_LePdfUnifieEst}" />
          <TextBlock Style="{StaticResource P}" Text="{DynamicResource S_Help_RegarderLeStatutDe}" />

          <TextBlock Style="{StaticResource H1}" Text="{DynamicResource S_Help_LeDisqueSeRemplit}" />
          <TextBlock Style="{StaticResource P}" Text="{DynamicResource S_Help_LeRepertoireDeTravail}" />

          <TextBlock Style="{StaticResource H1}" Text="{DynamicResource S_Help_RejouerUnMessageLitigieux}" />
          <TextBlock Style="{StaticResource P}" Text="{DynamicResource S_Help_LeMimeBrutEst}" />

          <TextBlock Style="{StaticResource H1}" Text="{DynamicResource S_Help_OuSontLesJournaux}" />
          <TextBlock Style="{StaticResource Code}" Text="{DynamicResource S_Help_LogList}" />
          <TextBlock Style="{StaticResource P}" Text="{DynamicResource S_Help_LeNiveauSeChange}" />

        </StackPanel>
      </ScrollViewer>
    </TabItem>
  </TabControl>
</mah:MetroWindow>
