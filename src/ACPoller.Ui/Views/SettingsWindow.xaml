<mah:MetroWindow x:Class="ACPoller.Ui.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:vm="clr-namespace:ACPoller.Ui.ViewModels"
                 Title="Reglages"
                 Height="520"
                 Width="660"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 TitleCharacterCasing="Normal">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </Window.Resources>

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="{DynamicResource S_Conn_ConnexionAuService}"
               FontSize="18" FontWeight="Light" Margin="0,0,0,16" />

    <TextBox Grid.Row="1"
             Text="{Binding BaseAddress, UpdateSourceTrigger=PropertyChanged}"
             mah:TextBoxHelper.Watermark="http://127.0.0.1:5199"
             mah:TextBoxHelper.UseFloatingWatermark="True"
             Tag="{DynamicResource S_Conn_AdresseDuService}"
             Margin="0,0,0,14" />

    <!-- PasswordBox n'est pas liable proprement, et masquer le jeton
         compliquerait la verification par l'exploitant sans rien proteger :
         il est depose en clair par l'installeur dans un fichier qu'il peut
         ouvrir. -->
    <TextBox Grid.Row="2"
             Text="{Binding Token, UpdateSourceTrigger=PropertyChanged}"
             mah:TextBoxHelper.Watermark="Depose par l'installeur, ou valeur de ControlApi:Token"
             mah:TextBoxHelper.UseFloatingWatermark="True"
             Tag="{DynamicResource S_Conn_JetonDePilotage}"
             FontFamily="Consolas"
             Margin="0,0,0,14" />

    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,16">
      <TextBlock Text="{DynamicResource S_Conn_Theme}" VerticalAlignment="Center" Margin="0,0,12,0" />
      <ComboBox ItemsSource="{Binding Source={x:Static vm:SettingsViewModel.Themes}}"
                SelectedItem="{Binding Theme}"
                Width="160" />
    </StackPanel>

    <StackPanel Grid.Row="4" Orientation="Horizontal">
      <Button Content="{DynamicResource S_Conn_TesterLaConnexion}"
              Command="{Binding TestCommand}"
              IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBool}}"
              Style="{StaticResource MahApps.Styles.Button.Square.Accent}"
              Padding="16,6" />
      <mah:ProgressRing Width="18" Height="18" Margin="12,0,0,0"
                        IsActive="{Binding IsTesting}" />
    </StackPanel>

    <TextBlock Grid.Row="5"
               Text="{Binding TestResult}"
               TextWrapping="Wrap"
               VerticalAlignment="Top"
               Margin="0,14,0,0"
               Foreground="{Binding TestSucceeded, Converter={StaticResource BoolToBrush}}" />

    <DockPanel Grid.Row="6">
      <Button DockPanel.Dock="Right" Content="{DynamicResource S_Conn_Enregistrer}"
              Click="OnSave"
              Style="{StaticResource MahApps.Styles.Button.Square.Accent}"
              Padding="20,6" Margin="8,0,0,0" />

      <Button DockPanel.Dock="Right" Content="{DynamicResource S_Conn_Annuler}"
              IsCancel="True"
              Style="{StaticResource MahApps.Styles.Button.Square}"
              Padding="20,6" />

      <!-- Les deux emplacements sont affiches : c'est la premiere question du
           support quand l'interface ne se connecte pas, savoir quel fichier
           est reellement lu. -->
      <StackPanel VerticalAlignment="Center">
        <TextBlock FontSize="10" Opacity="0.6"
                   TextTrimming="CharacterEllipsis"
                   MaxWidth="380" HorizontalAlignment="Left"
                   ToolTip="{Binding SettingsLocation}">
          <Run Text="{DynamicResource S_Conn_VosReglages}" />
          <Run Text="{Binding SettingsLocation, Mode=OneWay}" />
        </TextBlock>

        <!-- Affiche seulement s'il existe : sur un poste ou seule l'interface
             est installee, il n'y en a pas, et mentionner un fichier absent
             enverrait le support sur une fausse piste. -->
        <TextBlock FontSize="10" Opacity="0.6" Margin="0,2,0,0"
                   TextTrimming="CharacterEllipsis"
                   MaxWidth="380" HorizontalAlignment="Left"
                   Visibility="{Binding HasDefaults, Converter={StaticResource BoolToVisibility}}"
                   ToolTip="{Binding DefaultsLocation}">
          <Run Text="{DynamicResource S_Conn_ValeursDInstallation}" />
          <Run Text="{Binding DefaultsLocation, Mode=OneWay}" />
        </TextBlock>
      </StackPanel>
    </DockPanel>
  </Grid>
</mah:MetroWindow>
