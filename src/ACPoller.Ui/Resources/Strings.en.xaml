  <s:String x:Key="S_Connection">Connection</s:String>
  <s:String x:Key="S_Help">Help</s:String>
  <s:String x:Key="S_Save">Save</s:String>
  <s:String x:Key="S_Close">Close</s:String>
  <s:String x:Key="S_Cancel">Cancel</s:String>
  <s:String x:Key="S_Browse">Browse</s:String>
