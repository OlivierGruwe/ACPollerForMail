  <s:String x:Key="S_Edit_Valeur">Value</s:String>
  <s:String x:Key="S_Edit_Champs">Fields</s:String>
  <s:String x:Key="S_Edit_LOrdreFaitFoi">Order matters: it is the CSV column order. Moving them changes the output format.</s:String>
  <s:String x:Key="S_Edit_Monter">Move up</s:String>
  <s:String x:Key="S_Edit_Descendre">Move down</s:String>
