  <s:String x:Key="S_Dashboard">Dashboard</s:String>
  <s:String x:Key="S_TabGeneral">General</s:String>
  <s:String x:Key="S_TabProtocol">Protocol</s:String>
  <s:String x:Key="S_TabConversion">Conversion</s:String>
  <s:String x:Key="S_TabOutput">Output format</s:String>
  <s:String x:Key="S_TabProcessors">Processors</s:String>
