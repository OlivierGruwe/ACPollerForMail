  <s:String x:Key="S_Edit_EmpreinteDeCertificatPreferable">Certificate thumbprint (preferable to a secret)</s:String>
  <s:String x:Key="S_Edit_UnCertificatNExpire">A certificate does not expire on a Friday evening without warning.</s:String>
  <s:String x:Key="S_Edit_LimitationDeDebit">Throttling</s:String>
