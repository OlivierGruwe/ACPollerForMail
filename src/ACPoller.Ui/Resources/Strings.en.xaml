  <s:String x:Key="S_Edit_PieceNonConvertible">Unconvertible part</s:String>
  <s:String x:Key="S_Edit_SubstituteProduitUnePage">Substitute produces a page carrying the reason, Skip drops the part, RejectMessage rejects the whole message.</s:String>
