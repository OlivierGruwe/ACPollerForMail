  <s:String x:Key="S_Edit_NomDeLaCible">Target name</s:String>
  <s:String x:Key="S_Edit_ReprisDansLesJournaux">Repeated in the logs: without a name, errors are unreadable.</s:String>
  <s:String x:Key="S_Edit_SystemeDeFichiers">File system</s:String>
  <s:String x:Key="S_Edit_RepertoireDeDepotLocal">Delivery folder (local or UNC)</s:String>
  <s:String x:Key="S_Edit_CreerLeRepertoireS">Create the folder if it does not exist</s:String>
  <s:String x:Key="S_Edit_FtpFtps">FTP / FTPS</s:String>
  <s:String x:Key="S_Edit_RepertoireDistant">Remote directory</s:String>
  <s:String x:Key="S_Edit_Chiffrement">Encryption</s:String>
  <s:String x:Key="S_Edit_AccepterToutCertificatServeur">Accept any server certificate</s:String>
  <s:String x:Key="S_Edit_SupprimeTouteProtectionContre">Removes every protection against interception. Enable only against a known self-signed certificate, and document it.</s:String>
  <s:String x:Key="S_Edit_S3OuCompatible">S3 or compatible</s:String>
  <s:String x:Key="S_Edit_Bucket">Bucket</s:String>
  <s:String x:Key="S_Edit_PrefixeDesCles">Key prefix</s:String>
  <s:String x:Key="S_Edit_Region">Region</s:String>
  <s:String x:Key="S_Edit_PointDAccesPersonnalise">Custom endpoint (MinIO, Garage, Ceph)</s:String>
  <s:String x:Key="S_Edit_RenseigneLeStyleChemin">When filled in, path style and the compatible checksum mode are enabled automatically.</s:String>
  <s:String x:Key="S_Edit_CleDAccesVide">Access key (empty = AWS resolution chain)</s:String>
  <s:String x:Key="S_Edit_CleSecreteVideInchange">Secret key (empty = unchanged)</s:String>
  <s:String x:Key="S_Edit_ChiffrementAuRepos">Server-side encryption</s:String>
  <s:String x:Key="S_Edit_Aes256SurAwsLaisser">AES256 on AWS. Leave empty on MinIO or Garage with no server-side encryption configured, otherwise delivery is refused.</s:String>
  <s:String x:Key="S_Edit_DllDExportCliente">Customer export DLL</s:String>
  <s:String x:Key="S_Edit_Assemblage">Assembly</s:String>
  <s:String x:Key="S_Edit_LesReglagesPropresAu">Plugin-specific settings are entered in the table below.</s:String>
  <s:String x:Key="S_Edit_TousLesReglages">All settings</s:String>
  <s:String x:Key="S_Edit_LesChampsCiDessus">The fields above write into this very table. Adding a row here allows a setting no dedicated field covers.</s:String>
