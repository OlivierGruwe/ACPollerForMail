  <s:String x:Key="S_Edit_CleSecreteVideInchange">Cle secrete (vide = inchange)</s:String>
  <s:String x:Key="S_Edit_ChiffrementAuRepos">Chiffrement au repos</s:String>
  <s:String x:Key="S_Edit_Aes256SurAwsLaisser">AES256 sur AWS. Laisser vide sur MinIO ou Garage sans chiffrement serveur configure, sinon le depot est refuse.</s:String>
  <s:String x:Key="S_Edit_DllDExportCliente">DLL d'export cliente</s:String>
