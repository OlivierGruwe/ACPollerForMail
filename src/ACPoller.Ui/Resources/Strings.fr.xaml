  <s:String x:Key="S_Edit_ReprisDansLesJournaux">Repris dans les journaux : sans nom, les erreurs sont illisibles.</s:String>
  <s:String x:Key="S_Edit_SystemeDeFichiers">Systeme de fichiers</s:String>
  <s:String x:Key="S_Edit_RepertoireDeDepotLocal">Repertoire de depot (local ou UNC)</s:String>
