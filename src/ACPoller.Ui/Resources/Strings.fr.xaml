  <s:String x:Key="S_Edit_Chiffrement">Chiffrement</s:String>
  <s:String x:Key="S_Edit_AccepterToutCertificatServeur">Accepter tout certificat serveur</s:String>
  <s:String x:Key="S_Edit_SupprimeTouteProtectionContre">Supprime toute protection contre l'interception. A n'activer que sur un certificat auto-signe connu, et a documenter.</s:String>
  <s:String x:Key="S_Edit_S3OuCompatible">S3 ou compatible</s:String>
  <s:String x:Key="S_Edit_Bucket">Bucket</s:String>
  <s:String x:Key="S_Edit_PrefixeDesCles">Prefixe des cles</s:String>
  <s:String x:Key="S_Edit_Region">Region</s:String>
  <s:String x:Key="S_Edit_PointDAccesPersonnalise">Point d'acces personnalise (MinIO, Garage, Ceph)</s:String>
  <s:String x:Key="S_Edit_RenseigneLeStyleChemin">Renseigne, le style chemin et le mode de somme de controle compatible sont actives automatiquement.</s:String>
