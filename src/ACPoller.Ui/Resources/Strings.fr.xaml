  <s:String x:Key="S_Edit_OrigineDeLaValeur">Origine de la valeur</s:String>
  <s:String x:Key="S_Edit_FormatDeDateIgnore">Format de date (ignore si la valeur n'en est pas une)</s:String>
  <s:String x:Key="S_Edit_ValeurParDefautSi">Valeur par defaut si le resultat est vide</s:String>
