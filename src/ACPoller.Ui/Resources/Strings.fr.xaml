  <s:String x:Key="S_Edit_CheminDesFichiersEml">Chemin des fichiers .eml</s:String>
  <s:String x:Key="S_Edit_SertAuRejeuD">Sert au rejeu d'un message litigieux et a la recette, sans boite ni reseau.</s:String>
  <s:String x:Key="S_Edit_DossierEtDisposition">Dossier et disposition</s:String>
  <s:String x:Key="S_Edit_DossierSurveille">Dossier surveille</s:String>
  <s:String x:Key="S_Edit_NomCanoniqueEtNon">Nom canonique et non libelle : un libelle casse sur une boite localisee.</s:String>
