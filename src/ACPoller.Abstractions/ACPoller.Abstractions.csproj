<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- TFM neutre volontairement : un plugin client doit pouvoir etre compile et
         teste sans dependance Windows. Seuls le service et l'UI ciblent net10.0-windows. -->
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>ACPoller.Abstractions</PackageId>
    <Description>Contrat public d'extension d'ACPoller (sources, conversion, traitement, export).</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Seules dependances autorisees : des abstractions stables du framework.
         Aucune reference a MailKit, Graph, AWS ou PDFsharp : un plugin ne doit
         jamais etre couple a la version d'une librairie du core. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
