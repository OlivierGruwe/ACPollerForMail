<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      throwConfigExceptions="true"
      internalLogLevel="Warn"
      internalLogFile="${basedir}/logs/nlog-internal.log">

  <!-- Niveau pilotable sans recompilation ni redemarrage : la variable est
       surchargeable par la variable d'environnement ACPOLLER_LOGLEVEL.
       La v1 est passee de 150 Mo a 1 Go de log par jour sans aucun levier
       pour redescendre autrement qu'en livrant une nouvelle version. -->
  <variable name="minLevel" value="${environment:ACPOLLER_LOGLEVEL:whenEmpty=Info}" />

    <targets>
        <!-- Rotation quotidienne ET plafond de taille et de nombre de fichiers.
         Les deux sont necessaires : la rotation seule n'empeche pas un fichier
         du jour d'atteindre plusieurs giga-octets. -->
        <target xsi:type="File"
                name="file"
                fileName="${basedir}/logs/acpoller-${shortdate}.log"
                archiveEvery="Day"
                archiveAboveSize="52428800"
                maxArchiveFiles="30"
                maxArchiveDays="30"
                keepFileOpen="true"
                layout="${longdate}|${level:uppercase=true}|${logger}|${mdlc:item=CorrelationId}|${message}${onexception:|${exception:format=tostring}}" />

        <target xsi:type="File"
                name="errors"
                fileName="${basedir}/logs/acpoller-errors-${shortdate}.log"
                archiveEvery="Day"
                maxArchiveFiles="90"
                layout="${longdate}|${level:uppercase=true}|${logger}|${mdlc:item=CorrelationId}|${message}${onexception:|${exception:format=tostring}}" />
    </targets>

  <rules>
    <!-- Le bruit du framework est ecarte avant tout traitement : c'est la
         premiere source de volume inutile. -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />

    <logger name="*" minlevel="Warn" writeTo="errors" />
    <logger name="*" minlevel="${minLevel}" writeTo="file" />
  </rules>
</nlog>
